{
  "name": "browser-layer",
  "version": "0.1.3",
  "description": "A terminal browser for AI agents: pages as text maps, actions that answer with what changed, lists as records. Runs headless Chrome, Edge or Chromium.",
  "keywords": [
    "agent",
    "ai",
    "browser",
    "cli",
    "automation",
    "headless",
    "chrome",
    "llm",
    "web"
  ],
  "license": "Apache-2.0",
  "author": "Naman Rai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NAMANIND/browser-layer.git"
  },
  "homepage": "https://github.com/NAMANIND/browser-layer#readme",
  "bugs": {
    "url": "https://github.com/NAMANIND/browser-layer/issues"
  },
  "type": "module",
  "bin": {
    "browser-layer": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test \"test/*.test.ts\"",
    "measure": "tsc && node bench/measure.mjs",
    "record": "node bench/record-corpus.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "parse5": "^8.0.1",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
